    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.0.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
